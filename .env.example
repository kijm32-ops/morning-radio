# Required for Director + TTS
GEMINI_API_KEY=

# Gmail source collection
GMAIL_USER=
GMAIL_APP_PASSWORD=
WORLD_SUBJECT=WORLD BRIEFING
MORNING_SUBJECT=모닝 브리핑
PTIS_SUBJECT=[PTIS]
SOURCE_MAX_AGE_HOURS=36

# Kakao "send me"
KAKAO_REST_API_KEY=
KAKAO_CLIENT_SECRET=
KAKAO_TOKEN_ENCRYPTION_KEY=
KAKAO_REDIRECT_URI=http://127.0.0.1:8765/callback

# Optional local fallback; workflow uses actual Pages deployment URL
PLAYER_BASE_URL=https://kijm32-ops.github.io/morning-radio/

# Model / voice defaults
DIRECTOR_MODEL=gemini-3.8-flash
TTS_MODEL=gemini-3.8-flash-tts
VOICE_A=Puck
VOICE_B=Kore
TARGET_MINUTES=18
